# ---- Local development ----
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/mkjobs
REDIS_URL=redis://localhost:6379/0
PORT=8000

# ---- Docker Compose (production-like) ----
# Used by the postgres container itself and to build DATABASE_URL inside
# api/worker/beat containers together with /run/secrets/postgres_password
POSTGRES_USER=mkjobs
POSTGRES_DB=mkjobs

# ---- App behaviour ----
LOG_LEVEL=INFO
CORS_ALLOW_ORIGINS=*
RATE_LIMIT_PER_MINUTE=120

# ---- Webhooks (numbered by prefix, add as many as you need) ----
# NEW_POSTINGS_WEBHOOK_1="https://example.com/hooks/new-postings-a"
# CLOSED_POSTINGS_WEBHOOK_1="https://example.com/hooks/closed-postings-a"
# POSTING_CHANGED_WEBHOOK_1="https://example.com/hooks/posting-changed-a"
